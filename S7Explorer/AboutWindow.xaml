<Window x:Class="S7Explorer.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        ResizeMode="NoResize" SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Margin="8"
            BorderBrush="#D0D0D0"
            BorderThickness="1"
            CornerRadius="6"
            Padding="24,20">
        <StackPanel>
            <!-- Başlık: ikon + ürün adı + sürüm -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Image Source="Resources/app_icon.ico" Width="48" Height="48"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Margin="0,0,14,0" VerticalAlignment="Top"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="S7Explorer" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtAboutVersion" FontSize="13" Margin="0,2,0,0"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="TxtAboutDescription" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>

            <!-- Yazma yolu emniyeti: hakkında kutusu da bunu hatırlatır -->
            <Border Margin="0,14,0,0" CornerRadius="4" Padding="12,8"
                    Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <ui:FontIcon Glyph="&#xE7BA;" FontSize="14" Margin="0,0,8,0"
                                 VerticalAlignment="Top" Foreground="#FB8C00"/>
                    <TextBlock x:Name="TxtAboutSafety" FontSize="12" TextWrapping="Wrap"
                               MaxWidth="350"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="TxtAboutLicense" FontSize="12" Margin="0,14,0,0"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>

            <TextBlock Margin="0,6,0,0" FontSize="12">
                <Hyperlink x:Name="LinkRepository"
                           NavigateUri="https://github.com/zafersars/S7Explorer"
                           RequestNavigate="Hyperlink_RequestNavigate">
                    <TextBlock x:Name="TxtRepositoryLink" Text="github.com/zafersars/S7Explorer"/>
                </Hyperlink>
            </TextBlock>

            <ui:SimpleStackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                 Spacing="8" Margin="0,20,0,0">
                <Button x:Name="BtnClose" MinWidth="88" Height="32" Click="BtnClose_Click"
                        Style="{StaticResource AccentButtonStyle}"/>
            </ui:SimpleStackPanel>
        </StackPanel>
    </Border>
</Window>
