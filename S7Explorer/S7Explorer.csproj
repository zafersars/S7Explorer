<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>true</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<ApplicationIcon>Resources\app_icon.ico</ApplicationIcon>
		<Platforms>AnyCPU;x64</Platforms>
		<!-- Boyut küçültme: SelfContained EXE ~150MB → ~100-110MB -->
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<!-- WPF native DLL'leri (wpfgfx_cor3, PresentationNative_cor3, vcruntime140_cor3...)
		     varsayılan olarak tek dosyanın dışında kalır; EXE tek başına indirilince
		     pencere oluşurken DllNotFoundException ile çöker. -->
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
	</PropertyGroup>
	<ItemGroup>
		<Resource Include="Resources\app_icon.ico" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="lang\*.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<!-- Manuel test sayfası tanımları. qr-hatti.json makineye özeldir; kalıcı yeri
		     (depoda örnek mi, saha başına dosya mı) henüz kararlaştırılmadı. -->
		<Content Include="pages\*.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<!-- Siemens SCL kaynakları (DbParser girdisi). qr-hatti.json gibi DB_PC de
		     QR etiketleme hattına özeldir; DB_Trace halka tampon izleme bloğudur. -->
		<Content Include="db\*.db">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="ModernWpfUI" Version="0.9.6" />
	  <PackageReference Include="S7netplus" Version="0.20.0" />
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="Setup\" />
	</ItemGroup>
</Project>