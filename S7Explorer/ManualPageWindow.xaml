<Window x:Class="S7Explorer.ManualPageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manual Test Page"
        Width="1320" Height="880" MinWidth="1060" MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Icon="Resources/app_icon.ico"
        Background="#FFECEFF2"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Alarm satırı: saat, durum simgesi, mesaj -->
        <DataTemplate x:Key="AlarmRowTemplate">
            <Grid Margin="0,7,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="66"/>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Time}" FontSize="12" Foreground="#FF556170"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                           Foreground="{Binding Accent}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="12.5"
                           Foreground="{Binding MessageBrush}"
                           TextDecorations="{Binding MessageDecorations}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <!-- Düşen alarmın saati: satır geçmişte kaldığını kendisi söylesin. -->
                <TextBlock Grid.Column="3" Text="{Binding ClearedTime}" FontSize="11" Foreground="#FF8A95A1"
                           Margin="6,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Başlık ──────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="White" BorderBrush="#FFDBE0E5" BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid>
                <TextBlock x:Name="LblScreenTitle" Text="MANUEL KONTROL"
                           FontSize="30" FontWeight="Bold" Foreground="#FF1F2937"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="LblDate" Text="--.--.----" FontSize="13" Foreground="#FF556170"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="LblClock" Text="--:--:--" FontSize="13" Foreground="#FF556170"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Komut şeridi ────────────────────────────────────────────────── -->
        <Border Grid.Row="1" Background="White" BorderBrush="#FFDBE0E5" BorderThickness="0,0,0,1"
                Padding="24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="LblPageSelect" Grid.Column="0" Text="SAYFA" FontWeight="Bold" FontSize="10"
                           Foreground="#FF8A95A1" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="CmbPages" Grid.Column="1" MinWidth="300" Height="32"
                          VerticalContentAlignment="Center" SelectionChanged="CmbPages_SelectionChanged"/>

                <Button x:Name="BtnReload" Grid.Column="2" Width="92" Height="32" Margin="10,0,0,0"
                        Style="{StaticResource HmiButtonStyle}"
                        Background="White" BorderBrush="#FFDBE0E5" BorderThickness="1"
                        Foreground="#FF1F2937" Click="BtnReload_Click">
                    <TextBlock x:Name="TxtBtnReload" Text="Yenile" FontSize="12" FontWeight="SemiBold"/>
                </Button>

                <Button x:Name="BtnStartStop" Grid.Column="3" Width="152" Height="32" Margin="10,0,0,0"
                        Style="{StaticResource HmiButtonStyle}"
                        Background="#FF43A047" BorderBrush="#FF357A38" BorderThickness="1"
                        Foreground="White" IsEnabled="False" Click="BtnStartStop_Click">
                    <TextBlock x:Name="TxtBtnStartStop" Text="İzlemeyi başlat" FontSize="12" FontWeight="Bold"/>
                </Button>

                <!-- Yazma yetkisi: varsayılan kapalı, bilinçli açılır -->
                <Border x:Name="ArmBanner" Grid.Column="5" Background="#FFFFF4DC" BorderBrush="#FFF5A623"
                        BorderThickness="1.5" CornerRadius="8" Padding="12,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="IconArm" Text="" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#FFB27100" VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBlock x:Name="LblReadOnlyBanner" Text="SALT OKUNUR" FontSize="11"
                                   FontWeight="Bold" Foreground="#FF8A5A00"
                                   VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <CheckBox x:Name="ChkArmWrite" Content="Yazmayı etkinleştir" IsEnabled="False"
                                  Foreground="#FF1F2937" FontSize="12" VerticalAlignment="Center"
                                  Checked="ChkArmWrite_Changed" Unchecked="ChkArmWrite_Changed"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ── Doğrulama ──────────────────────────────────────────────────── -->
        <Expander Grid.Row="2" x:Name="ExpValidation" IsExpanded="False"
                  Background="White" Foreground="#FF556170" Padding="24,2" BorderBrush="#FFDBE0E5"
                  BorderThickness="0,0,0,1">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="IconValidation" Text="" FontFamily="Segoe MDL2 Assets"
                               FontSize="12" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtValidationHeader" Text="Doğrulama" FontWeight="SemiBold" FontSize="12"/>
                </StackPanel>
            </Expander.Header>
            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="LstValidation" Margin="24,6,10,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding SeverityText}" FontWeight="Bold"
                                           FontSize="11" Foreground="{Binding SeverityBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Path}" FontFamily="Consolas"
                                           FontSize="11" Margin="0,0,12,0" Foreground="#FF8A95A1"/>
                                <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="11"
                                           TextWrapping="Wrap" Foreground="#FF556170"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Expander>

        <!-- ── Ekran gövdesi ──────────────────────────────────────────────── -->
        <TabControl Grid.Row="3" x:Name="TabsMain" Background="Transparent" BorderThickness="0"
                    Margin="18,10,6,0" Padding="0">
            <TabItem x:Name="TabControls" Header="Kumanda">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Margin="0,10,0,0">
                    <StackPanel>
                        <Border x:Name="ManualModeWarning" Visibility="Collapsed"
                                Background="#FFFFEBEE" BorderBrush="#FFE53935"
                                BorderThickness="1.5" CornerRadius="8" Padding="14,9" Margin="0,0,12,12">
                            <TextBlock x:Name="LblManualModeWarning" FontWeight="SemiBold" FontSize="12"
                                       Foreground="#FFB3241F" TextWrapping="Wrap"
                                       Text="Makine manuel modda değil — komutlar pasif."/>
                        </Border>

                        <!-- Ekipman kartları ve alarm paneli çalışma anında üretilir -->
                        <WrapPanel x:Name="PanelControls"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="TabValues" Header="Canlı Değerler">
                <DataGrid x:Name="GridValues" Margin="0,10,12,0"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" RowHeight="24"
                          Background="White" BorderBrush="#FFDBE0E5" BorderThickness="1"
                          HorizontalGridLinesBrush="#FFEAEEF1" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="ColRole"    Header="Rol"     Binding="{Binding Role}"     Width="120"/>
                        <DataGridTextColumn x:Name="ColLabel"   Header="Etiket"  Binding="{Binding Label}"    Width="190"/>
                        <DataGridTextColumn x:Name="ColSymbol"  Header="Sembol"  Binding="{Binding Symbol}"   Width="2*"/>
                        <DataGridTextColumn x:Name="ColAddress" Header="Adres"   Binding="{Binding Address}"  Width="110"/>
                        <DataGridTextColumn x:Name="ColType"    Header="Tip"     Binding="{Binding DataType}" Width="80"/>
                        <DataGridTextColumn x:Name="ColValue"   Header="Değer"   Binding="{Binding Value}"    Width="130"
                                            FontWeight="SemiBold"/>
                        <DataGridTextColumn x:Name="ColState"   Header="Durum"   Binding="{Binding State}"    Width="1*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- ── Alt durum çubuğu ───────────────────────────────────────────── -->
        <Border Grid.Row="4" Background="White" BorderBrush="#FFDBE0E5" BorderThickness="0,1,0,0"
                Padding="24,10">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Ellipse x:Name="DotSystem" Width="26" Height="26" Fill="#FFBDC4CB"
                             VerticalAlignment="Center"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="LblSystemCaption" Text="SİSTEM DURUMU" FontSize="10"
                                   FontWeight="Bold" Foreground="#FF8A95A1"/>
                        <TextBlock x:Name="LblSystemState" Text="BAĞLI DEĞİL" FontSize="14"
                                   FontWeight="Bold" Foreground="#FF556170"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               Foreground="#FF8A95A1" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="LblCycleCaption" Text="ÇEVRİM SÜRESİ" FontSize="10"
                                   FontWeight="Bold" Foreground="#FF8A95A1"/>
                        <TextBlock x:Name="LblCycle" Text="—" FontSize="14" FontWeight="Bold"
                                   Foreground="#FF1F2937"/>
                    </StackPanel>
                    <TextBlock x:Name="LblOverrun" Text="" FontSize="11" Foreground="#FF8A95A1"
                               VerticalAlignment="Bottom" Margin="16,0,0,2"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
