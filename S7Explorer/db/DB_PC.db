DATA_BLOCK "DB_PC"
TITLE = Haberleşme DB
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
//PC ile haberleşme bloğu
//
// V4 DEGISIKLIGI (2026-08) : Send.IO.Input icindeki buton bitleri tasindi.
//   Start/Stop/Reset/Emergency/Gate sinyalleri %I0.0-%I0.4 ten
//   %I12.0-%I12.4 e alindi (HSC1 encoder girisleri icin yer acildi).
//   Bu yuzden bu bitler byte 116 dan byte 118 e (eski Reserve_I9.x) tasindi.
//
// V4 SAHA REVIZYONU (2026-08) : SADECE UC SINYAL TASINDI.
//   HSC1 icin yalnizca %I0.0 ve %I0.1 bosaltilmak zorundaydi. Sahada
//   %I0.0, %I0.1 ve %I0.2 tasindi; %I0.3 (Acil Stop) ve %I0.4 (Kapi)
//   iscilik nedeniyle YERINDE BIRAKILDI.
//     Start     %I0.0 -> %I12.0   ayna 118.0
//     Stop      %I0.1 -> %I12.1   ayna 118.1
//     Reset     %I0.2 -> %I12.2   ayna 118.2
//     Emergency %I0.3  DEGISMEDI  ayna 116.3   <-- ORIJINAL OFSETINE DONDU
//     Gate      %I0.4  DEGISMEDI  ayna 116.4   <-- ORIJINAL OFSETINE DONDU
//   Emergency ve Gate boylece ESKI PROGRAMDAKI ofsetlerinde kaldi; PC
//   yazilimi bu iki bit icin hicbir sey degistirmek zorunda degil.
//   BAYT OFSETLERI DEGISMEDI - sadece isimler yer degistirdi.
//   PC yazilimi ofset okuyorsa etkilenmez, isim okuyorsa guncellenmelidir.
//
// V4 REZERV ISIMLENDIRMESI (2026-08) : Kullanilan rezerv bitlerine anlamli
//   isim verildi. HICBIR ALAN EKLENMEDI/SILINMEDI, HICBIR OFSET KAYMADI.
//   Blok boyu 218 bayt olarak AYNI kaldi (hesaplayarak dogrulandi).
//
//   !! ALARM BITI ISIMLENDIRME KURALI !!
//   Send.Alarm.* icindeki HER bit "TRUE = SORUN VAR" anlamindadir; FB_Alarm
//   bunlari toplayip Error/Warning ve isik kulesini surer. Bu yuzden bir
//   alarm bitine olumlu bir isim (ornegin "CommReady") verilmemelidir:
//   isim ile deger birbirinin tersi olur ve ileride mutlaka yanlis okunur.
//   Olumlu bilgi Send.State icine yazilir (orn. Send.State.CommReady).
   STRUCT 
      Receive : Struct
         Control : Struct   // PC'den Gelen Kontrol Bitleri
            Life : Bool;   // PC - PLC haberleşme var biti
            Start : Bool;   // Otomatik Başlat
            Stop : Bool;   // Otomatik Durdur
            Reset : Bool;   // Program değerlerini sıfırla, PLC 0'a çekecek
            Home : Bool;   // Program ve tüm ekipmanları başlangıç konumu al, PLC 0'a çekecek
            Acknowledge : Bool;   // Alarmları onaylamak ve Sürücüler alarm reset
            RejectSide : Bool;   // Boşaltma pistonı boşaltma yönü. 0 = Sol, 1 = Sağ
            ApplicatorSide : Bool;   // Etiketleme çalışma yönü. 0 = Sol, 1 = Sol/Sağ
            Test { ExternalVisible := 'False'} : Bool;   // Test modda çalışıyor
            Manual : Bool;   // Manuel modda çalışma
            ManRejFw : Bool;   // Manuel modda Reject pistonu ileri git
            ManRejBw : Bool;   // Manuel modda Reject pistonu geri git
            ManTrigger : Bool;   // Manuel modda Kamera tetik
            ManApplicatorL : Bool;   // Manuel modda Sol aplikatör tetik
            ManApplicatorR : Bool;   // Manuel modda Sağ aplikatör tetik
            ResetCounter : Bool;   // Koli içi adet sıfırla
            ManMain : Bool;   // Manuel modda Ana konveyör kontrol
            ManSpacing : Bool;   // Manuel modda Ara açma kontrol
            ManSideHolding : Bool;   // Manuel modda Yan baskı kontrol
            ManTopHolding : Bool;   // Manuel modda Üst baskı kontrol
            ManIdler : Bool;   // Manuel modda boş konveyör kontrol
            OnlyLabel : Bool;   // SADECE ETIKETLEME modu. Konveyorler aktiflik durumuna gore calisir, ETIKETLEME calisir, KAMERA ve REJECT calismaz.
            OnlyQR : Bool;   // SADECE QR modu. Konveyorler aktiflik durumuna gore calisir, KAMERA ve REJECT calisir, ETIKETLEME calismaz.
            Bypass : Bool;   // TAM BYPASS. Konveyorler aktiflik durumuna gore calisir, ETIKETLEME, KAMERA ve REJECT calismaz.
            MainAct : Bool;   // Ana konveyör aktif / pasif
            SpacingAct : Bool;   // Ara açma aktif / pasif
            TopHoldingAct : Bool;   // Üst baskı aktif / pasif
            SideHoldingAct : Bool;   // Yan baskı aktif / pasif
            IdlerAct : Bool;   // Boş konveyör aktif / pasif
            Reserve_30 : Bool;
            Reserve_31 : Bool;
            Reserve_32 : Bool;
         END_STRUCT;
         "Time" : Struct   // İşlem zamanları (Aksi belirtilmeyen tüm zamanlar milisaniye)
            StartDelay : UInt;   // Başlama işleminde ara açmanın gecikme süresi
            StopDelay : UInt;   // Durma işleminde ana  konveyörün gecikme süresi
            AplicatorDelay : UInt;   // Aplikatör poke sensörü gecikme süresi
            AplicatorTrigger : UInt;   // Aplikatör tetik süresi
            CameraDelay : UInt;   // Kamera poke sensörü gecikme süresi
            CameraTimeout : UInt;   // Kamera zaman aşım süresi
            BoxDelay : UInt;   // Kutu adet sayıcı gecikme süresi
            BoxReset : UInt;   // Kutu adet sayıcı piston reset  süresi
            Reserve_9 : UInt;
            BuzzerDischarge : UInt;   // Sesli ikaz, bozuk atma için ötme süresi
            BuzzerPoke : UInt;   // Sesli ikaz, poke için ötme süresi
            RejectPreDelay : UInt;   // Reject pistonu ön gecikme
            RejectDelayS : UInt;   // Reject pistonu set gecikme
            RejectDelayR : UInt;   // Reject pistonu reset gecikme
            RejectAlmS : UInt;   // Reject pistonu set alarm
            RejectAlmR : UInt;   // Reject pistonu reset alarm
         END_STRUCT;
         Velocity : Struct   // AC Motor hız değerleri
            Main : Word;   // Ana konveyör hız bilgisi (Hz)
            Spacing : Word;   // Ara açma hız bilgisi (Hz)
            TopHolding : Word;   // Üst baskı hız bilgisi (Hz)
            SideHolding : Word;   // Yan baskı hız bilgisi (Hz)
            Idler : Word;   // Boş konveyör hız bilgisi (Hz)
            Reserve_6 : Word;
            Reserve_7 : Word;
            Reserve_8 : Word;
         END_STRUCT;
         Other : Struct   // Diğer parametreler
            ACDriveCount : UInt;   // Modbus ile kontrol edilecek AC sürücü sayısı
            DischargeCount : UInt;   // Peşpeşe okunamayan QR kod sayısı
            BoxCount : UInt;   // Kutu içi adet
            ModbusRtuDelay : UInt;
            LoadFreqDelay : UInt;
            Reserve_6 : Word;
            Reserve_7 : Word;
            Reserve_8 : Word;
            Reserve_9 : Word;
            Reserve_10 : Word;
            Reserve_11 : Word;
            Reserve_12 : Word;
            Reserve_13 : Word;
            Reserve_14 : Word;
            Reserve_15 : Word;
            Reserve_16 : Word;
            Reserve_17 : Word;
            Reserve_18 : Word;
            Reserve_19 : Word;
            Reserve_20 : Word;
            Reserve_21 : Word;
            Reserve_22 : Word;
            Reserve_23 : Word;
            Reserve_24 : Word;
         END_STRUCT;
      END_STRUCT;
      Send : Struct
         Control : Struct   // PC'ye Gönderilen kontrol bitleri
            Life : Bool;   // PC - PLC haberleşme var biti
            Reserve_2 : Bool;
            Reserve_3 : Bool;
            Reserve_4 : Bool;
            Reserve_5 : Bool;
            Reserve_6 : Bool;
            Reserve_7 : Bool;
            Reserve_8 : Bool;
            Reserve_9 : Bool;
            Reserve_10 : Bool;
            Reserve_11 : Bool;
            Reserve_12 : Bool;
            Reserve_13 : Bool;
            Reserve_14 : Bool;
            Reserve_15 : Bool;
            Reserve_16 : Bool;
            Reserve_17 : Bool;
            Reserve_18 : Bool;
            Reserve_19 : Bool;
            Reserve_20 : Bool;
            Reserve_21 : Bool;
            Reserve_22 : Bool;
            Reserve_23 : Bool;
            Reserve_24 : Bool;
            Reserve_25 : Bool;
            Reserve_26 : Bool;
            Reserve_27 : Bool;
            Reserve_28 : Bool;
            Reserve_29 : Bool;
            Reserve_30 : Bool;
            Reserve_31 : Bool;
            Reserve_32 : Bool;
         END_STRUCT;
         State : Struct   // PC'ye Gönderilen durum bitleri
            Stop : Bool;   // Makine Stop modda
            Run : Bool;   // Otomatik modda çalışyor
            Manual : Bool;   // Manuel modda çalışıyor
            Bypass : Bool;   // Bypass modda çalışıyor
            Test { ExternalVisible := 'False'} : Bool;   // Test modda çalışıyor
            Reset_DO : Bool;   // Reset yapılıyor
            Reset_OK : Bool;   // Reset yapıldı
            Home_DO : Bool;   // Home yapılıyor
            Home_OK : Bool;   // Home yapıldı
            Pos_DO : Bool;   // Pozisyona gidiliyor
            Pos_OK : Bool;   // Pozisyona gidildi
            Ready : Bool;   // Çalışmaya hazır
            Message : Bool;   // Mesaj var (Alarm bitleri kontrol edilecek)
            Warning : Bool;   // Uyarı var (Alarm bitleri kontrol edilecek)
            Error : Bool;   // Hata var (Alarm bitleri kontrol edilecek)
            CommReady : Bool;   // Modbus portu kuruldu
            DefaultLoaded : Bool;   // Fabrika ayarı yüklendi (kilitli)
            CmdReverted : Bool;   // Açılıştan beri en az bir PC komut biti zaman aşımına uğrayıp geri çekildi (TRUE ise sebep PC tarafındadır)
            OnlyLabel : Bool;   // SADECE ETIKETLEME modu uretimde aktif
            OnlyQR : Bool;   // SADECE QR modu uretimde aktif
            Reserve_21 : Bool;
            Reserve_22 : Bool;
            Reserve_23 : Bool;
            Reserve_24 : Bool;
            Reserve_25 : Bool;
            Reserve_26 : Bool;
            Reserve_27 : Bool;
            Reserve_28 : Bool;
            Reserve_29 : Bool;
            Reserve_30 : Bool;
            Reserve_31 : Bool;
            Reserve_32 : Bool;
         END_STRUCT;
         Alarm : Struct   // PC'ye Gönderilen alarm bilgileri
            Emergency : Bool;   // Acil stop basılı (Acil stop bırakılıp reset yapılana kadar gönderilir.)
            Gate : Bool;   // Kapı açık
            NotStart : Bool;   // Makine çalıştırılamadı
            NotStop : Bool;   // Makine durdurulamadı
            ScrapRepeat : Bool;   // Peşpeşe hatalı ürün
            RejectFull : Bool;   // Reject haznesi dolu
            AcFault : Bool;   // AC Sürücüler hatadan çıkartılamadı
            AlarmTrackLost : Bool;   // NG ürün ateşlenemeden geçti (piston meşgul / geç kaldı / kuyruk taştı)
            AlarmNoConfirm : Bool;   // NG ürün teyit sensöründe GÖRÜLMEDİ (ürün düştü / kaydı / sensör arızası)
            Main : Bool;   // Ana konveyör alarm
            Spacing : Bool;   // Ara açma konveyör alarm
            SideHolding : Bool;   // Yan baskı konveyör alarm
            TopHolding : Bool;   // Üst baskı konveyör alarm
            Idler : Bool;   // Boş konveyör alarm
            AlarmMissed : Bool;   // Ürün tetiklenemeden geçti
            CommLost : Bool;   // Haberleşme koptu (Test modda daima FALSE)
            RejectAlmS : Bool;   // Reject pistonu ileri gidemedi
            RejectAlmR : Bool;   // Reject pistonu geri gidemedi
            EverCorrected : Bool;   // Açılıştan beri kırpma oldu (PC'ye bilgi)
            ModbusFault : Bool;   // Modbus portu KURULAMADI (TRUE = sorun) Olumlu hali: Send.State.CommReady
            FillJam : Bool;   // Ana konveyor sonunda urun sikismasi (doluluk sensoru %I0.2)
            Reserve_22 : Bool;
            Reserve_23 : Bool;
            Reserve_24 : Bool;
            Reserve_25 : Bool;
            Reserve_26 : Bool;
            Reserve_27 : Bool;
            Reserve_28 : Bool;
            Reserve_29 : Bool;
            Reserve_30 : Bool;
            Reserve_31 : Bool;
            Reserve_32 : Bool;
            Reserve_33 : Bool;
            Reserve_34 : Bool;
            Reserve_35 : Bool;
            Reserve_36 : Bool;
            Reserve_37 : Bool;
            Reserve_38 : Bool;
            Reserve_39 : Bool;
            Reserve_40 : Bool;
            Reserve_41 : Bool;
            Reserve_42 : Bool;
            Reserve_43 : Bool;
            Reserve_44 : Bool;
            Reserve_45 : Bool;
            Reserve_46 : Bool;
            Reserve_47 : Bool;
            Reserve_48 : Bool;
            Reserve_49 : Bool;
            Reserve_50 : Bool;
            Reserve_51 : Bool;
            Reserve_52 : Bool;
            Reserve_53 : Bool;
            Reserve_54 : Bool;
            Reserve_55 : Bool;
            Reserve_56 : Bool;
            Reserve_57 : Bool;
            Reserve_58 : Bool;
            Reserve_59 : Bool;
            Reserve_60 : Bool;
            Reserve_61 : Bool;
            Reserve_62 : Bool;
            Reserve_63 : Bool;
            Reserve_64 : Bool;
         END_STRUCT;
         IO : Struct   // PLC IO bitleri, ekranda gösterilmesi için
            Input : Struct
               "Reserve_I0.0" : Bool;   // %I0.0 = ENCODER A (HSC1) - aynalanmaz
               "Reserve_I0.1" : Bool;   // %I0.1 = ENCODER B (HSC1) - aynalanmaz
               FillSensor : Bool;   // %I0.2 Ana konveyor doluluk sensoru (NO: urun varken TRUE)
               Emergency : Bool;   // Acil Stop role hazir  (%I0.3, NC)
               Gate : Bool;   // Kapi kapali           (%I0.4, NC)
               RejectBw : Bool;   // Atma pistonu geride
               RejectFw : Bool;   // Atma pistonu ileride
               RejectPoke : Bool;   // Atma ürün varlık sensörü
               CameraPoke : Bool;   // Kamere ürün varlık sensörü
               ApplicatorReady_L : Bool;   // Sol aplikatör hazır sinyali
               ApplicatorReserve_L : Bool;   // Sol aplikatör rezerv sinyal
               ApplicatorReady_R : Bool;   // Sağ aplikatör hazır sinyali
               ApplicatorReserve_R : Bool;   // Sağ aplikatör rezerv sinyal
               ApplicatorPoke : Bool;   // Apilkatör ürün varlık sensörü
               ResultsOK : Bool;   // Kamera okuma başarılı
               ResultsNG : Bool;   // Kamera okuma başarısız
               Start : Bool;   // Start butonu          (%I12.0)
               Stop : Bool;   // Stop butonu           (%I12.1, NC)
               Reset : Bool;   // Reset butonu          (%I12.2)
               IdlerAck : Bool;   // %I12.3 Robottan bos konveyor calisma izni (TRUE = calisabilir)
               "Reserve_I12.4" : Bool;   // %I12.4 bosta - Kapi %I0.4'te kaldi
               "Reserve_I12.5" : Bool;
               "Reserve_I12.6" : Bool;
               "Reserve_I12.7" : Bool;
            END_STRUCT;
            Output : Struct
               "Reserve_0.0" : Bool;
               "Reserve_0.1" : Bool;
               CameraTrigger : Bool;   // Kamera tetik
               Emg_Relay : Bool;   // Acil Stop rölesi kur
               RejectBw : Bool;   // Atma pistonu geride
               RejectFw : Bool;   // Atma pistonu ileride
               "Reserve_0.6" : Bool;   // %Q0.6 bosta
               "Reserve_0.7" : Bool;   // %Q0.7 bosta
               Lt_Green : Bool;   // Işık kulesi YEŞİL lamba      (%Q8.0)
               Lt_Red : Bool;   // Işık kulesi KIRMIZI lamba    (%Q8.1)
               Lt_Yellow : Bool;   // Işık kulesi SARI lamba       (%Q8.2)
               Lt_Buzzer : Bool;   // Sesli ikaz                   (%Q8.3)
               ApplicatorStart_L : Bool;   // Sol aplikatör başlat  (%Q8.4)
               ApplicatorReset_L : Bool;   // Sol aplikatör reset   (%Q8.5)
               ApplicatorStart_R : Bool;   // Sağ aplikatör başlat  (%Q8.6)
               ApplicatorReset_R : Bool;   // Sağ aplikatör reset   (%Q8.7)
               "Reserve_9.0" : Bool;
               "Reserve_9.1" : Bool;
               "Reserve_9.2" : Bool;
               "Reserve_9.3" : Bool;
               "Reserve_9.4" : Bool;
               "Reserve_9.5" : Bool;
               "Reserve_9.6" : Bool;
               "Reserve_9.7" : Bool;
            END_STRUCT;
         END_STRUCT;
         Velocity : Struct   // AC Motor hız değerleri
            Main : Word;   // Ana konveyör hız bilgisi (Hz)
            Spacing : Word;   // Ara açma hız bilgisi (Hz)
            TopHolding : Word;   // Üst baskı hız bilgisi (Hz)
            SideHolding : Word;   // Yan baskı hız bilgisi (Hz)
            Idler : Word;   // Boş konveyör hız bilgisi (Hz)
            Reserve_6 : Word;
            Reserve_7 : Word;
            Reserve_8 : Word;
         END_STRUCT;
         Other : Struct
            rSpeed_mpm : Word;   // Konveyör hızı, ONDA BİR m/dk -> PC 10'A BÖLMELİ örnek: 352 = 35.2 m/dk
            uiCntOK : Word;   // Toplam OK adedi
            uiCntNG : Word;   // Toplam NG adedi
            uiCntTimeout : Word;   // Toplam kamera zaman aşımı adedi
            uiSeqNG : Word;   // PEŞPEŞE okunamayan ürün sayısı (Alarm.ScrapRepeat bundan üretilir)
            uiQueueCount : Word;   // Reject kuyruğundaki NG ürün sayısı (izleme)
            uiValveState : Word;   // REJECT PİSTONU durum numarası (izleme) 0 home / 5 konum bilinmiyor / 10 atış / 30 dönüş / 50 home rutini / 90 manuel / 99 arıza DİKKAT: makine adım numarası ayrı alandır -> Send.Other.nState
            uiCorrections : Word;   // Bu çevrimde kırpılan PC parametresi adedi
            rCycle_ms : Word;   // OB1 çevrim süresi, ONDA BİR ms -> PC 10'A BÖLMELİ örnek: 27 = 2.7 ms
            uiRevertCount : Word;   // Zaman aşımına uğrayıp geri çekilen PC komut biti adedi. Artmaya devam ediyorsa PC bağlantısı kopuyor demektir.
            Reserve_11 : Word;
            Reserve_12 : Word;
            Reserve_13 : Word;
            Reserve_14 : Word;
            Reserve_15 : Word;
            Reserve_16 : Word;
            Reserve_17 : Word;
            Reserve_18 : Word;
            Reserve_19 : Word;
            Reserve_20 : Word;
            nBoxCount : Word;
            Reserve_22 : Word;
            Reserve_23 : Word;
            Reserve_24 : Word;
            Reserve_25 : Word;
            Reserve_26 : Word;
            nState : UInt;
            "Result Length" : UInt;   // Kamera okunan veri uzunluğu
            Result : String[32];   // Kamera okunan veri
            PLC_Serial : String[16];
            Plc_Name : String[16];
            Plc_Time : String[32];   // PLC'nin aktif lokal tarih saat
         END_STRUCT;
      END_STRUCT;
      Local : Struct
         AcDrive : Struct
            MainAct : Bool;   // Ana konveyör aktif / pasif
            SpacingAct : Bool;   // Ara açma aktif / pasif
            TopHoldingAct : Bool;   // Üst baskı aktif / pasif
            SideHoldingAct : Bool;   // Yan baskı aktif / pasif
            IdlerAct : Bool;   // Boş konveyör aktif / pasif
            "Reserve_700.5" : Bool;
            "Reserve_700.6" : Bool;
            "Reserve_700.7" : Bool;
         END_STRUCT;
         Control : Struct
            Gate : Bool;   // Kapılar aktif / pasif
            CameraTrig : Bool;   // Kamera tetiğinin çalışma şekli
            Acknowledge : Bool;   // Hata silme biti
            LoadDefault : Bool;
            IdlerRobotControl : Bool;   // %DB1.DBX302.4  (varsayilan FALSE)   FALSE = bos konveyor uretim boyunca SUREKLI calisir   TRUE  = bos konveyor SADECE IdlerAck (%I12.3) TRUE iken calisir
         END_STRUCT;
         Default : Struct
            Control : Struct
               Test : Bool;
            END_STRUCT;
            Velocity : Struct   // AC Motor hız değerleri
               Main : Word;   // Ana konveyör hız bilgisi (Hz)
               Spacing : Word;   // Ara açma hız bilgisi (Hz)
               TopHolding : Word;   // Üst baskı hız bilgisi (Hz)
               SideHolding : Word;   // Yan baskı hız bilgisi (Hz)
               Idler : Word;   // Boş konveyör hız bilgisi (Hz)
               Reserve_6 : Word;
               Reserve_7 : Word;
               Reserve_8 : Word;
            END_STRUCT;
            AcDrive : Struct
               MainAct : Bool;   // Ana konveyör aktif / pasif
               SpacingAct : Bool;   // Ara açma aktif / pasif
               TopHoldingAct : Bool;   // Üst baskı aktif / pasif
               SideHoldingAct : Bool;   // Yan baskı aktif / pasif
               IdlerAct : Bool;   // Boş konveyör aktif / pasif
               "Reserve_700.5" : Bool;
               "Reserve_700.6" : Bool;
               "Reserve_700.7" : Bool;
            END_STRUCT;
         END_STRUCT;
      END_STRUCT;
   END_STRUCT;


BEGIN
   Receive.Control.Stop := TRUE;
   Receive.Control.Test := TRUE;
   Receive.Control.MainAct := TRUE;
   Receive.Control.SpacingAct := TRUE;
   Receive."Time".StartDelay := 2000;
   Receive."Time".StopDelay := 3000;
   Receive."Time".AplicatorDelay := 200;
   Receive."Time".AplicatorTrigger := 50;
   Receive."Time".CameraDelay := 20;
   Receive."Time".CameraTimeout := 500;
   Receive."Time".BoxDelay := 500;
   Receive."Time".BoxReset := 1000;
   Receive."Time".BuzzerDischarge := 5000;
   Receive."Time".BuzzerPoke := 200;
   Receive."Time".RejectPreDelay := 100;
   Receive."Time".RejectDelayS := 100;
   Receive."Time".RejectDelayR := 100;
   Receive."Time".RejectAlmS := 5000;
   Receive."Time".RejectAlmR := 5000;
   Receive.Velocity.Main := 16#00C8;
   Receive.Velocity.Spacing := 16#00C8;
   Receive.Velocity.TopHolding := 16#00C8;
   Receive.Velocity.SideHolding := 16#00C8;
   Receive.Velocity.Idler := 16#00C8;
   Receive.Other.ACDriveCount := 2;
   Receive.Other.DischargeCount := 5;
   Receive.Other.BoxCount := 3;
   Receive.Other.ModbusRtuDelay := 100;
   Receive.Other.LoadFreqDelay := 5000;
   Send.Control.Life := TRUE;
   Send.State.Run := TRUE;
   Send.State.Test := TRUE;
   Send.State.Reset_OK := TRUE;
   Send.State.Pos_DO := TRUE;
   Send.IO.Input.Emergency := TRUE;
   Send.IO.Input.Gate := TRUE;
   Send.IO.Input.RejectBw := TRUE;
   Send.IO.Input.ApplicatorPoke := TRUE;
   Send.IO.Input.Stop := TRUE;
   Send.IO.Output.RejectBw := TRUE;
   Send.IO.Output.Lt_Green := TRUE;
   Send.Velocity.Main := 16#00C8;
   Send.Velocity.Spacing := 16#00C8;
   Send.Velocity.SideHolding := 16#00C8;
   Send.Velocity.Idler := 16#00C8;
   Local.AcDrive.MainAct := TRUE;
   Local.AcDrive.SpacingAct := TRUE;
   Local.Control.CameraTrig := TRUE;
   Local.Default.Control.Test := TRUE;
   Local.Default.Velocity.Main := 200;
   Local.Default.Velocity.Spacing := 200;
   Local.Default.Velocity.TopHolding := 200;
   Local.Default.Velocity.SideHolding := 200;
   Local.Default.Velocity.Idler := 200;
   Local.Default.AcDrive.MainAct := TRUE;

END_DATA_BLOCK

